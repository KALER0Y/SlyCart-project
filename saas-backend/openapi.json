    "/api/core/shops/{shop_id}/product": {
      "post": {
        "operationId": "core_api_create_product_endpoint",
        "summary": "Create Product Endpoint",
        "parameters": [
          {
            "in": "path",
            "name": "shop_id",
            "schema": {
              "format": "uuid",
              "title": "Shop Id",
              "type": "string"
            },
            "required": true
