                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          }
        },
        "tags": [
          "POST"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "title": "MultiPartBodyParams",
                "type": "object",
                "properties": {
                  "title": {
                    "title": "Title",
                    "type": "string"
                  },
                  "description": {
                    "title": "Description",
                    "type": "string"
                  },
                  "price": {
                    "anyOf": [
                      {
                        "minimum": 0.0,
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
                        "type": "string"
                      }
                    ],
                    "title": "Price"
                  },
                  "stock": {
                    "exclusiveMinimum": 0,
                    "title": "Stock",
                    "type": "integer"
                  },
                  "is_active": {
                    "default": true,
                    "title": "Is Active",
                    "type": "boolean"
                  },
                  "image": {
                    "format": "binary",
                    "title": "Image",
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "description",
                  "price",
                  "stock",
                  "image"
                ]
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "CookieJWTAuth": []
          },
          {
            "RefreshCookieJWTAuth": []
          },
          {
            "InitDataJWTAuth": []
          }
        ]
      }
    },
